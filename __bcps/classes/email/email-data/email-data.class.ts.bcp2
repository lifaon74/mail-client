import { EmailHeaders } from '../email-headers/email-headers.class';
import { CRLF, CRLF_LENGTH } from '../../../constants/crlf';
import { MIMEType } from '../../mime-type/mime-type.class';
import { CONTENT_TYPE_HEADER_NAME } from '../email-headers/well-known/content-type/content-type-header-name.constant';

/** TYPES **/

export interface IEmailDataBody {
  (): string;
}

export interface IEmailDataBuilder {
  (
    headers: EmailHeaders,
    body: string,
  ): EmailData | undefined;
}

/** CLASS **/

export class EmailData {
  static parse(
    input: string,
    builders: readonly IEmailDataBuilder[] = [],
  ): EmailData {
    const index: number = input.indexOf(CRLF + CRLF);

    if ((index === -1) || !input.endsWith(CRLF)) {
      throw new Error(`Invalid EmailData`);
    } else {
      const headers: EmailHeaders = EmailHeaders.parse(input.slice(0, index));
      const body: string = input.slice(index + CRLF_LENGTH + CRLF_LENGTH, -CRLF_LENGTH);

      for (let i = 0, l = builders.length; i < l; i++) {
        const builder: IEmailDataBuilder = builders[i];
        const emailData: EmailData | undefined = ;
      }
      const contentType: MIMEType | undefined = headers.getContentType();

      if (contentType === void 0) {
        throw new Error(`Missing ${CONTENT_TYPE_HEADER_NAME} header.`);
      } else {

      }
      return new EmailData(
        headers,
        this.#parseBody(
          input.slice(index + CRLF_LENGTH + CRLF_LENGTH, -CRLF_LENGTH),
          headers,
        ),
      );
    }
  }

  readonly #headers: EmailHeaders;
  readonly #body: IEmailDataBody;

  constructor(
    headers: EmailHeaders,
    body: IEmailDataBody,
  ) {
    this.#headers = headers;
    this.#body = body;
  }

  get headers(): EmailHeaders {
    return this.#headers;
  }

  get body(): IEmailDataBody {
    return this.#body;
  }

  toString(): string {
    return this.headers.toString() + CRLF
      + CRLF
      + this.#body()
      + CRLF
      ;
  }
}


