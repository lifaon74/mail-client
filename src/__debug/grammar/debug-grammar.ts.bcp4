export function execGrammarByteSequenceComparison(
  node: IGrammarByteSequenceComparisonAstNode,
  buffer: Uint8Array,
  index: number,
): INextFunction<IExecResultByteSequence> {
  return onceNextFunction((): IExecResultByteSequence | null => {
    const expressions: readonly IGrammarByteComparisonExpressionAstNode[] = node.expressions;
    const length: number = expressions.length;

    if (buffer.length >= length) {
      for (let i: number = 0, j: number = index; i < length; i++, j++) {
        if (!execGrammarByteComparisonExpression(expressions[i], buffer[j])) {
          return null;
        }
      }

      return {
        __type__: 'byte-sequence',
        start: index,
        end: index + length,
      };
    } else {
      return null;
    }
  });
}

export function execGrammarEnd(
  buffer: Uint8Array,
  index: number,
): INextFunction<IExecResultEnd> {
  return onceNextFunction((): IExecResultEnd | null => {
    if (index === buffer.length) {
      return {
        __type__: 'end',
        start: index,
        end: index,
      };
    } else {
      return null;
    }
  });
}

export function execGrammarAlternative(
  node: IGrammarAlternativeAstNode,
  rules: IGrammarRulesMap,
  buffer: Uint8Array,
  index: number,
): INextFunction<IExecResultAlternative> {
  const expressions: readonly IGrammarExpressionAstNode[] = node.expressions;
  const expressionsLength: number = expressions.length;
  let expressionIndex: number = 0;

  let _next: INextFunction<IExecResult> | null = EMPTY_NEXT_FUNCTION;

  return (): IExecResultAlternative | null => {
    while (_next !== null) {
      const _result: IExecResult | null = _next();

      if (_result === null) {
        _next = (expressionIndex < expressionsLength)
          ? execGrammarExpression(
            expressions[expressionIndex++],
            rules,
            buffer,
            index,
          )
          : null;
      } else {
        return {
          __type__: 'alternative',
          start: index,
          end: _result.end,
          child: _result,
        };
      }
    }

    return null;
  };

  // return switchMapNextFunction(
  //   (): IExecResultNextFunction | null => {
  //     return (expressionIndex < expressionsLength)
  //       ? execGrammarExpression(
  //         expressions[expressionIndex++],
  //         rules,
  //         buffer,
  //         index,
  //       )
  //       : null;
  //   },
  //   (next: IExecResultNextFunction): IExecResultNextFunction => {
  //     return next;
  //   },
  // );
}

export function execGrammarConcat(
  node: IGrammarConcatAstNode,
  rules: IGrammarRulesMap,
  buffer: Uint8Array,
  index: number,
): IExecResultNextFunction {
  const nextFunctions: IExecResultSuccessNextFunction[] = [];

  for (let i = 0, li = node.expressions.length; i < li; i++) {
    const expression: IGrammarExpressionAstNode = node.expressions[i];

    const result: IExecResultNextFunction = execGrammarExpression(
      expression,
      rules,
      buffer,
      index,
    );

    if (result.__type__ === 'error') {
      return {
        __type__: 'error',
        __subtype__: 'contact',
        index: index,
        error: result,
      };
    } else {
      nextFunctions.push(result.next);
    }
  }

  console.log(nextFunctions);
  return {
    __type__: 'success',
    next: mapNextFunction(
      parallelNextFunctions<IExecResult>(nextFunctions),
      (
        children: readonly IExecResult[],
      ): IExecResult => {
        return {
          __type__: 'concat',
          start: index,
          end: (children.length === 0)
            ? index
            : children[children.length - 1].end,
          children,
        };
      },
    ),
  };
}

export function execGrammarExpression(
  node: IGrammarExpressionAstNode,
  rules: IGrammarRulesMap,
  buffer: Uint8Array,
  index: number,
): INextFunction<IExecResult> {
  if (isGrammarAlternativeAstNode(node)) {
    return execGrammarAlternative(
      node,
      rules,
      buffer,
      index,
    );
  } else if (isGrammarByteSequenceComparisonAstNode(node)) {
    return execGrammarByteSequenceComparison(
      node,
      buffer,
      index,
    );
  } else if (isGrammarConcatAstNode(node)) {
    return execGrammarConcat(
      node,
      rules,
      buffer,
      index,
    );
  } else if (isGrammarEndAstNode(node)) {
    return execGrammarEnd(
      buffer,
      index,
    );
  } else if (isGrammarRepeatAstNode(node)) {
    throw 'TODO';
    // return execGrammarRepeat(
    //   node,
    //   rules,
    //   buffer,
    //   index,
    // );
  } else if (isGrammarRuleIdentifierAstNode(node)) {
    throw 'TODO';
    // return execGrammarRuleIdentifier(
    //   node,
    //   rules,
    //   buffer,
    //   index,
    // );
  } else {
    throw new Error(`Unknown node: ${(node as IGrammarExpressionAstNode).__type__}`);
  }
}

export function execGrammarRule(
  node: IGrammarRuleAstNode,
  rules: IGrammarRulesMap,
  buffer: Uint8Array,
  index: number,
): IExecResultNextFunction {
  return mapNextFunction(
    execGrammarExpression(
      node.expression,
      rules,
      buffer,
      index,
    ),
    (
      result: IExecResult,
    ): IExecResult => {
      return {
        __type__: 'rule',
        name: node.name,
        start: result.start,
        end: result.end,
        child: result,
      };
    },
  );
}

export function execGrammar(
  node: IGrammarAstNode,
  rule: string,
  buffer: Uint8Array,
  index: number,
): IExecResultNextFunction {
  const rules: IGrammarRulesMap = new Map<string, IGrammarRuleAstNode>(
    node.rules.map((rule: IGrammarRuleAstNode): [string, IGrammarRuleAstNode] => {
      return [
        rule.name,
        rule,
      ];
    }),
  );

  return execGrammarRule(
    rules.get(rule)!,
    rules,
    buffer,
    index,
  );
}

