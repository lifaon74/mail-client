import { EMPTY_NEXT_FUNCTION } from './next-function/empty-next-function';

/*---------*/

export function execGrammarByteComparisonEquals(
  node: IGrammarByteComparisonEqualsAstNode,
  value: number,
): boolean {
  return value === node.value;
}

export function execGrammarByteComparisonNotEquals(
  node: IGrammarByteComparisonNotEqualsAstNode,
  value: number,
): boolean {
  return value !== node.value;
}

export function execGrammarByteComparisonGreaterThan(
  node: IGrammarByteComparisonGreaterThanAstNode,
  value: number,
): boolean {
  return value > node.value;
}

export function execGrammarByteComparisonGreaterThanOrEquals(
  node: IGrammarByteComparisonGreaterThanOrEqualsAstNode,
  value: number,
): boolean {
  return value >= node.value;
}

export function execGrammarByteComparisonLowerThan(
  node: IGrammarByteComparisonLowerThanAstNode,
  value: number,
): boolean {
  return value < node.value;
}

export function execGrammarByteComparisonLowerThanOrEquals(
  node: IGrammarByteComparisonLowerThanOrEqualsAstNode,
  value: number,
): boolean {
  return value <= node.value;
}

export function execGrammarByteComparisonAnd(
  node: IGrammarByteComparisonAndAstNode,
  value: number,
): boolean {
  for (let i: number = 0, l: number = node.expressions.length; i < l; i++) {
    if (!execGrammarByteComparisonExpression(node.expressions[i], value)) {
      return false;
    }
  }
  return true;
}

export function execGrammarByteComparisonOr(
  node: IGrammarByteComparisonOrAstNode,
  value: number,
): boolean {
  for (let i: number = 0, l: number = node.expressions.length; i < l; i++) {
    if (execGrammarByteComparisonExpression(node.expressions[i], value)) {
      return true;
    }
  }
  return false;
}

export function execGrammarByteComparisonNot(
  node: IGrammarByteComparisonNotAstNode,
  value: number,
): boolean {
  return !execGrammarByteComparisonExpression(node.expression, value);
}

export function execGrammarByteComparisonExpression(
  node: IGrammarByteComparisonExpressionAstNode,
  value: number,
): boolean {
  if (isGrammarByteComparisonAndAstNode(node)) {
    return execGrammarByteComparisonAnd(node, value);
  } else if (isGrammarByteComparisonEqualsAstNode(node)) {
    return execGrammarByteComparisonEquals(node, value);
  } else if (isGrammarByteComparisonGreaterThanAstNode(node)) {
    return execGrammarByteComparisonGreaterThan(node, value);
  } else if (isGrammarByteComparisonGreaterThanOrEqualsAstNode(node)) {
    return execGrammarByteComparisonGreaterThanOrEquals(node, value);
  } else if (isGrammarByteComparisonLowerThanAstNode(node)) {
    return execGrammarByteComparisonLowerThan(node, value);
  } else if (isGrammarByteComparisonLowerThanOrEqualsAstNode(node)) {
    return execGrammarByteComparisonLowerThanOrEquals(node, value);
  } else if (isGrammarByteComparisonNotAstNode(node)) {
    return execGrammarByteComparisonNot(node, value);
  } else if (isGrammarByteComparisonNotEqualsAstNode(node)) {
    return execGrammarByteComparisonNotEquals(node, value);
  } else if (isGrammarByteComparisonOrAstNode(node)) {
    return execGrammarByteComparisonOr(node, value);
  } else {
    throw new Error(`Unknown node: ${(node as IGenericAstNode).__type__}`);
  }
}

/*-------------*/

export interface IExecResultSuccessAlternativeShared<GType extends string> extends IAstNode<GType> {
  readonly start: number;
  readonly end: number;
}

export interface IExecResultSuccessByteSequence extends IExecResultSuccessAlternativeShared<'byte-sequence'> {

}

export interface IExecResultSuccessEnd extends IExecResultSuccessAlternativeShared<'end'> {

}

export interface IExecResultSuccessAlternative extends IExecResultSuccessAlternativeShared<'alternative'> {
  readonly child: IExecResultSuccessResult;
}

export interface IExecResultSuccessConcat extends IExecResultSuccessAlternativeShared<'concat'> {
  readonly children: readonly IExecResultSuccessResult[];
}

export interface IExecResultSuccessRule extends IExecResultSuccessAlternativeShared<'rule'> {
  readonly name: string;
  readonly child: IExecResultSuccessResult;
}

export type IExecResultSuccessResult =
  | IExecResultSuccessByteSequence
  | IExecResultSuccessEnd
  | IExecResultSuccessAlternative
  | IExecResultSuccessConcat
  | IExecResultSuccessRule
  ;

export type IExecResultSuccessNextFunction = INextFunction<IExecResultSuccessResult>

export interface IExecResultSuccess extends IAstNode<'success'> {
  readonly next: IExecResultSuccessNextFunction;
}

export function mapNextFunction<GIn, GOut>(
  next: INextFunction<GIn>,
  map: (value: GIn) => GOut,
): INextFunction<GOut> {
  return (): GOut | null => {
    const result: GIn | null = next();
    return (result === null)
      ? null
      : map(result);
  };
}

export function sequentialNextFunctions<GValue>(
  nextFunctions: readonly INextFunction<GValue>[],
): INextFunction<GValue> {
  const length: number = nextFunctions.length;
  let index: number = 0;
  return (): GValue | null => {
    while (index < length) {
      const result: GValue | null = nextFunctions[index]();
      if (result === null) {
        index++;
      } else {
        return result;
      }
    }
    return null;
  };
}

export function switchMapNextFunction<GIn, GOut>(
  next: INextFunction<GIn>,
  map: (value: GIn) => INextFunction<GOut>,
): INextFunction<GOut> {
  let _next: INextFunction<GOut> | null = EMPTY_NEXT_FUNCTION;

  return (): GOut | null => {
    while (_next !== null) {
      const _result: GOut | null = _next();

      if (_result === null) {
        const result: GIn | null = next();
        _next = (result === null)
          ? null
          : map(result);
      } else {
        return _result;
      }
    }

    return null;
  };
}

export function parallelNextFunctions<GValue>(
  nextFunctions: readonly INextFunction<GValue>[],
  index: number = 0,
  values: readonly GValue[] = [],
): INextFunction<readonly GValue[]> {
  if (index < nextFunctions.length) {
    return switchMapNextFunction(
      nextFunctions[index],
      (
        value: GValue,
      ): INextFunction<readonly GValue[]> => {
        return parallelNextFunctions(
          nextFunctions,
          index + 1,
          [
            ...values,
            value,
          ],
        );
      },
    );
  } else {
    return singleValueNextFunction(values);
  }
}

export function forEachNextFunction(
  next: IExecResultSuccessNextFunction,
  callback: (result: IExecResultSuccessResult) => void,
): void {
  let result: IExecResultSuccessResult | null;
  while ((result = next()) !== null) {
    callback(result);
  }
}

export interface IExecResultError extends IAstNode<'error'> {
  readonly __subtype__: string;
  readonly index: number;

  readonly [key: string]: any;
}

export type IExecResult =
  | IExecResultSuccess
  | IExecResultError;

export function execGrammarByteSequenceComparison(
  node: IGrammarByteSequenceComparisonAstNode,
  buffer: Uint8Array,
  index: number,
): IExecResult {
  const length: number = node.expressions.length;
  if (buffer.length >= length) {
    for (let i: number = 0, j: number = index; i < length; i++, j++) {
      if (!execGrammarByteComparisonExpression(node.expressions[i], buffer[j])) {
        return {
          __type__: 'error',
          __subtype__: 'byte-sequence',
          index: j,
        };
      }
    }

    return {
      __type__: 'success',
      next: singleValueNextFunction({
        __type__: 'byte-sequence',
        start: index,
        end: index + length,
      }),
    };
  } else {
    return {
      __type__: 'error',
      __subtype__: 'byte-sequence',
      index,
    };
  }
}

export function execGrammarEnd(
  buffer: Uint8Array,
  index: number,
): IExecResult {
  if (index === buffer.length) {
    return {
      __type__: 'success',
      next: singleValueNextFunction({
        __type__: 'end',
        start: index,
        end: index,
      }),
    };
  } else {
    return {
      __type__: 'error',
      __subtype__: 'end',
      index,
    };
  }
}

export function execGrammarAlternative(
  node: IGrammarAlternativeAstNode,
  rules: IGrammarRulesMap,
  buffer: Uint8Array,
  index: number,
): IExecResult {
  const errors: IExecResultError[] = [];
  const nextFunctions: IExecResultSuccessNextFunction[] = [];

  for (let i = 0, li = node.expressions.length; i < li; i++) {
    const expression: IGrammarExpressionAstNode = node.expressions[i];

    const result: IExecResult = execGrammarExpression(
      expression,
      rules,
      buffer,
      index,
    );

    if (result.__type__ === 'error') {
      errors.push(result);
    } else {
      nextFunctions.push(result.next);
    }
  }

  if (nextFunctions.length === 0) {
    return {
      __type__: 'error',
      __subtype__: 'alternative',
      index,
      errors,
    };
  } else {
    return {
      __type__: 'success',
      next: mapNextFunction(
        sequentialNextFunctions(nextFunctions),
        (result: IExecResultSuccessResult): IExecResultSuccessResult => {
          return {
            __type__: 'alternative',
            start: result.start,
            end: result.end,
            child: result,
          };
        },
      ),
    };
  }
}

export function execGrammarConcat(
  node: IGrammarConcatAstNode,
  rules: IGrammarRulesMap,
  buffer: Uint8Array,
  index: number,
): IExecResult {
  const nextFunctions: IExecResultSuccessNextFunction[] = [];
  
  for (let i = 0, li = node.expressions.length; i < li; i++) {
    const expression: IGrammarExpressionAstNode = node.expressions[i];

    const result: IExecResult = execGrammarExpression(
      expression,
      rules,
      buffer,
      index,
    );

    if (result.__type__ === 'error') {
      return {
        __type__: 'error',
        __subtype__: 'contact',
        index: index,
        error: result,
      };
    } else {
      nextFunctions.push(result.next);
    }
  }

  console.log(nextFunctions);
  return {
    __type__: 'success',
    next: mapNextFunction(
      parallelNextFunctions<IExecResultSuccessResult>(nextFunctions),
      (
        children: readonly IExecResultSuccessResult[],
      ): IExecResultSuccessResult => {
        return {
          __type__: 'concat',
          start: index,
          end: (children.length === 0)
            ? index
            : children[children.length - 1].end,
          children,
        };
      },
    ),
  };
}

export function execGrammarExpression(
  node: IGrammarExpressionAstNode,
  rules: IGrammarRulesMap,
  buffer: Uint8Array,
  index: number,
): IExecResult {
  if (isGrammarAlternativeAstNode(node)) {
    return execGrammarAlternative(
      node,
      rules,
      buffer,
      index,
    );
  } else if (isGrammarByteSequenceComparisonAstNode(node)) {
    return execGrammarByteSequenceComparison(
      node,
      buffer,
      index,
    );
  } else if (isGrammarConcatAstNode(node)) {
    return execGrammarConcat(
      node,
      rules,
      buffer,
      index,
    );
  } else if (isGrammarEndAstNode(node)) {
    return execGrammarEnd(
      buffer,
      index,
    );
  } else if (isGrammarRepeatAstNode(node)) {
    throw 'TODO';
    // return execGrammarRepeat(
    //   node,
    //   rules,
    //   buffer,
    //   index,
    // );
  } else if (isGrammarRuleIdentifierAstNode(node)) {
    throw 'TODO';
    // return execGrammarRuleIdentifier(
    //   node,
    //   rules,
    //   buffer,
    //   index,
    // );
  } else {
    throw new Error(`Unknown node: ${(node as IGrammarExpressionAstNode).__type__}`);
  }
}

export function execGrammarRule(
  node: IGrammarRuleAstNode,
  rules: IGrammarRulesMap,
  buffer: Uint8Array,
  index: number,
): IExecResult {
  const result: IExecResult = execGrammarExpression(
    node.expression,
    rules,
    buffer,
    index,
  );

  if (result.__type__ === 'error') {
    return {
      __type__: 'error',
      __subtype__: 'rule',
      name: node.name,
      index: index,
      error: result,
    };
  } else {
    return {
      __type__: 'success',
      next: mapNextFunction(
        result.next,
        (
          result: IExecResultSuccessResult,
        ): IExecResultSuccessResult => {
          return {
            __type__: 'rule',
            name: node.name,
            start: result.start,
            end: result.end,
            child: result,
          };
        },
      ),
    };
  }
}

export function execGrammar(
  node: IGrammarAstNode,
  rule: string,
  buffer: Uint8Array,
  index: number,
): IExecResult {
  const rules: IGrammarRulesMap = new Map<string, IGrammarRuleAstNode>(
    node.rules.map((rule: IGrammarRuleAstNode): [string, IGrammarRuleAstNode] => {
      return [
        rule.name,
        rule,
      ];
    }),
  );

  return execGrammarRule(
    rules.get(rule)!,
    rules,
    buffer,
    index,
  );
}

