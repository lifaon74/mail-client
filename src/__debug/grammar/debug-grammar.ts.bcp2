export function debugGrammar() {
  // /.+b$/g
  // /[^b]+b$/g

  // const test = GrammarRule('test', GrammarAlternative([
  //   GrammarString('a'),
  //   GrammarString('b'),
  // ]));

  const test = GrammarRule('test', GrammarConcat([
    GrammarString('a'),
    GrammarString('b'),
  ]));

  // const test = GrammarRule('test', GrammarRepeatZeroOrMore(
  //   GrammarByteRange(0, 255),
  // ));

  // const test = GrammarRule('test', GrammarConcat([
  //   GrammarRepeatZeroOrMore(
  //     GrammarByteRange(0, 255),
  //   ),
  //   // GrammarString('b'),
  //   GrammarEnd,
  // ]));

  // const test = GrammarRule('test', GrammarAlternative([
  //   GrammarString('b'),
  //   GrammarString('a'),
  // ]));

  const _id = GrammarRule('test', GrammarConcat([
    GrammarString('a'),
    GrammarString('b'),
  ]));

  const grammar = Grammar([
    test,
  ]);

  const str: string = `ab`;

  const buffer = new TextEncoder().encode(str);

  const result = execGrammar(grammar, 'test', buffer, 0);
  if (result.__type__ === 'success') {
    forEachNextFunction(result.next, (result: IExecResultSuccessResult): void => {
      console.log(result);
    });
  } else {
    console.log(result);
  }
}

